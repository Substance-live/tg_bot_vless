# ── Telegram ───────────────────────────────────────────────────────────
# Токен бота от @BotFather. Пусто → бот не запускается, работает только API.
BOT_TOKEN=

# ── API (FastAPI) ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── База данных (Postgres) ─────────────────────────────────────────────
# В docker-compose host = имя сервиса "db". Локально — localhost.
DATABASE_URL=postgresql+asyncpg://vpn:vpn@db:5432/vpn_orchestrator
# Значения для контейнера postgres (docker-compose):
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn
POSTGRES_DB=vpn_orchestrator

# Redis в MVP не используется (оставлен на будущее).
REDIS_URL=redis://localhost:6379/0

# ── Безопасность (пост-MVP: Admin API/JWT) ─────────────────────────────
JWT_SECRET=change-me-in-production

# ── Администраторы ─────────────────────────────────────────────────────
# Telegram ID начальных админов. JSON [123,456] или CSV 123,456.
ADMIN_TELEGRAM_IDS=

# ── Взаимодействие с Node Agent ────────────────────────────────────────
NODE_AGENT_TIMEOUT_SECONDS=10
NODE_AGENT_RETRY_COUNT=3

# ── Сидинг узлов ───────────────────────────────────────────────────────
# JSON-массив узлов. Секреты задаются ТОЛЬКО здесь, не через Telegram.
# Связь с агентом — по HTTP на порт 8080 (без TLS/nginx).
# Локальный узел (агент на этом же хосте, network_mode: host):
#   agent_url = http://host.docker.internal:8080
# Удалённый узел: agent_url = http://<PUBLIC_IP>:8080
# Пример:
# NODES=[{"name":"Node-DE","country":"DE","agent_url":"http://host.docker.internal:8080","agent_secret":"SECRET_DE"},{"name":"Node-NL","country":"NL","agent_url":"http://5.6.7.8:8080","agent_secret":"SECRET_NL"}]
NODES=[]

# ── Логирование ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
